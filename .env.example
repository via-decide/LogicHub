# LogicHub Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to version control

# Environment
NODE_ENV=production

# Authentication
AUTH_SECRET=your-super-secret-jwt-key-minimum-32-characters-recommended-for-production
AUTH_SESSION_MAXAGE=2592000
AUTH_JWT_EXPIRY=2592000

# Database (PostgreSQL)
DATABASE_URL=postgresql://logichub_user:secure_password_here@localhost:5432/logichub
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Server
API_PORT=3000
API_HOST=localhost
NODE_ENV=production

# CORS
CORS_ORIGIN=https://logichub.app

# SSL/TLS (for production HTTPS)
SSL_ENABLED=false
SSL_KEY_PATH=/etc/ssl/private/logichub.key
SSL_CERT_PATH=/etc/ssl/certs/logichub.crt

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Security
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_COOKIE_NAME=auth_session

# OAuth Providers (if enabled)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@logichub.app

# Monitoring/Analytics (optional)
SENTRY_DSN=
ANALYTICS_TRACKING_ID=

# Feature Flags
FEATURE_USER_REGISTRATION=true
FEATURE_OAUTH=false
FEATURE_TWO_FACTOR_AUTH=false
