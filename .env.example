# LogicHub environment variables.
#
# This file is COMMITTED and must never contain a real value. Copy it to
# `.env` for local development (`.env` is gitignored), and set production
# values via `vercel env add` / the Vercel dashboard — never here.

# ---------- Required: database ----------
# Postgres connection string, read by api/_pg.js.
# MUST be the transaction pooler (port 6543), not the direct connection:
# serverless functions exhaust direct connections, and api/_pg.js sets
# `prepare: false` to match transaction-mode pooling.
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=

# ---------- Required: auth ----------
# HMAC signing key for session tokens (api/_sovereignAuth.js).
# SHARED SECRET: aporaksha/auth/token.js signs with this same variable.
# Rotate it in both services at once or cross-service tokens stop validating.
SECRET_KEY=

# Gates the admin routes (api/admin/dashboard.js, api/admin-grant-paid.js).
# Defaults to "" — set a strong random value before the site is public.
FIREBASE_ADMIN_SECRET=

# Falls back to SECRET_KEY when unset. Set separately so rotating one
# does not invalidate the other.
WAITLIST_TOKEN_SECRET=

# ---------- Payments ----------
# Compared literally against the string 'true'; anything else disables payments.
PAYMENTS_ENABLED=false
# Comma-separated extra CORS origins beyond the built-in list.
PAYMENTS_ALLOWED_ORIGINS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Email (waitlist confirmations) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_EMAIL=
# Base URL used to build confirmation links. Wrong value = broken links.
PUBLIC_BASE_URL=https://logichub.app

# ---------- External services (all have working defaults) ----------
# Auth/entitlement service. Defaults to https://aporaksha.com.
APORAKSHA_API_URL=
# Defaults to https://daxini.xyz (api/access-status.js).
GATEWAY_URL=
# Auth fallback host. Defaults to https://node.daxini.xyz.
MACMINI_URL=
DAXINI_SPACE_API=

# ---------- Runtime / build ----------
SITE_URL=https://logichub.app
# Keep blank to use same-origin '/api' in production.
API_BASE_URL=
EXECUTION_ENGINE=gemini
# If present, exposed in HTML as: window.LOGICHUB_API_BASE
LOGICHUB_API_BASE=

# ---------- Optional features (not on the launch path) ----------
GEMINI_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
APK_SHELL_DIR=
IMAGE_API_URL=
IMAGE_API_KEY=
ZAYVORA_SECURE_TOKEN=
# Local dev only — points at a localhost tunnel, cannot resolve on Vercel.
ZAYVORA_TUNNEL_URL=http://localhost:8080

# ---------- Firebase (legacy; most routes now use DATABASE_URL) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# NOTE: NODE_ENV and PORT are managed by Vercel. Do not set them manually.
