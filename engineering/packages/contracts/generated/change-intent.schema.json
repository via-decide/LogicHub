{
  "$ref": "#/definitions/ChangeIntent",
  "definitions": {
    "ChangeIntent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "default": "0.1.0"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "baseRevisionId": {
          "type": "string",
          "minLength": 1
        },
        "targetBranch": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requestText": {
          "type": "string"
        },
        "changeType": {
          "type": "string",
          "minLength": 1
        },
        "requestedOperations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "add",
                  "remove",
                  "replace",
                  "move"
                ]
              },
              "objectId": {
                "type": "string",
                "minLength": 1
              },
              "expectedOldHash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expectedAbsent": {
                "type": "boolean"
              },
              "newObject": {
                "type": "object",
                "properties": {
                  "semanticId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "semanticHash": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "semanticId",
                  "semanticHash"
                ],
                "additionalProperties": false
              },
              "oldObjectId": {
                "type": "string",
                "minLength": 1
              },
              "newObjectId": {
                "type": "string",
                "minLength": 1
              },
              "expectedBodyHash": {
                "type": "string"
              }
            },
            "required": [
              "operation",
              "objectId"
            ],
            "additionalProperties": false
          }
        },
        "expectedObjectChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deltaType": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "oldSemanticId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "newSemanticId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "deltaType",
              "domain"
            ],
            "additionalProperties": false
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optimize": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "constraintId": {
                "type": "string",
                "minLength": 1
              },
              "mustHold": {
                "type": "boolean",
                "default": true
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "constraintId"
            ],
            "additionalProperties": false
          }
        },
        "approvalPolicy": {
          "type": "object",
          "properties": {
            "requiredApprovals": {
              "type": "integer",
              "minimum": 1
            },
            "autoMerge": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "requiredApprovals",
            "autoMerge"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "planned",
            "executing",
            "generated",
            "validating",
            "validated",
            "review",
            "accepted",
            "rejected",
            "failed",
            "cancelled"
          ],
          "default": "captured"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "projectId",
        "baseRevisionId",
        "targetBranch",
        "title",
        "changeType",
        "requestedOperations",
        "expectedObjectChanges",
        "preserve",
        "optimize",
        "constraints",
        "approvalPolicy",
        "createdBy",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
